{
  "name": "autogen",
  "productName": "AutoGen Test Studio",
  "version": "0.1.0",
  "description": "Desktop UI for AI-driven Playwright test-automation repositories: an agent explores your app and writes the tests.",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "mock:ollama": "node scripts/mock-ollama.mjs",
    "test:e2e": "npm run build && node e2e/smoke.mjs",
    "dist": "npm run build && electron-builder",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "chokidar": "3.6.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "37.10.3",
    "electron-builder": "25.1.8",
    "electron-vite": "4.0.1",
    "monaco-editor": "0.52.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.8.3",
    "vite": "^6.3.0"
  }
}
